{
  "installCommand": "npm install",
  "functions": {
    "api/holdings.js": {
      "includeFiles": "api/amfi-lookup.json"
    },
    "api/amfi/[code].js": {
      "includeFiles": "api/amfi-lookup.json"
    }
  },
  "headers": [
    {
      "source": "/catalog.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
